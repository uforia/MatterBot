# Copy to .env and fill in. .env is git-ignored; never commit real values.
#
# Values are rendered into a YAML config that MatterBot parses as Python literals,
# so avoid quote characters (' ") and backslashes in them.

# --- Required -----------------------------------------------------------------
# The bot account's password or personal access token.
MATTERBOT_TOKEN=
# Hostname of your Mattermost server, e.g. mattermost.example.com
MATTERMOST_HOST=
# The bot account's username.
MATTERBOT_USERNAME=
# The team name, as it appears in your Mattermost URL.
MATTERMOST_TEAM=

# --- Optional -----------------------------------------------------------------
# Defaults match a standard HTTPS Mattermost. For a plain-HTTP server on the
# default port, use MATTERMOST_SCHEME=http and MATTERMOST_PORT=8065.
#MATTERMOST_PORT=443
#MATTERMOST_SCHEME=https
# Mattermost user ID allowed to use admin-only commands (the system_admin role
# always is). Find it under the user's profile / System Console.
#MATTERBOT_ADMIN_ID=

# --- AI analyst (optional; see "AI Analyst" in the README) ---------------------
# Needs an OpenAI-compatible endpoint serving a model with native function calling.
#AI_ENABLED=False
#AI_BASE_URL=http://localhost:11434/v1
#AI_MODEL=
# Use any non-empty value (e.g. ollama) for a keyless local endpoint.
#AI_API_KEY=
